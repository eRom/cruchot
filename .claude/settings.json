{
  "enabledPlugins": {
    "serena@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit 2>&1 | head -5"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=\"$CLAUDE_TOOL_ARG_file_path\"; case \"$file\" in */ipc/*.ts|*/preload/*) echo '[IPC-CHECK] Fichier IPC modifie -- verifier coherence 3 couches';; esac"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "npm run test -- --bail 2>&1 | tail -5"
          }
        ]
      }
    ]
  }
}
